{
  "name": "flatnotes",
  "short_name": "flatnotes",
  "scope": "/",
  "start_url": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/markdown": [".md"],
        "text/plain": [".txt", ".cfg", ".ini"]
      },
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "theme_color": "#F8A66B",
  "background_color": "#ffffff",
  "display": "standalone"
}
